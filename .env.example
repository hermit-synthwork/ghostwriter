# Copy to .env and fill in. .env is gitignored.

# Google AI Studio key — https://aistudio.google.com/apikey
# Required by src/gen-art.ts (Gemini image generation). Nothing else needs it.
GEMINI_API_KEY=

# Optional: override the image model.
#   gemini-3.1-flash-image (default) | gemini-3.1-flash-lite-image | gemini-3-pro-image
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Zernio API key — Zernio dashboard → API Keys → create key
# Required by src/publish.ts (Instagram carousel via Zernio).
# The IG/TikTok account ids + handles are non-secret and live in tenants/<id>.json.
ZERNIO_API_KEY=

# Anthropic API key — console.anthropic.com → API keys. Required by src/write-story.ts.
ANTHROPIC_API_KEY=
