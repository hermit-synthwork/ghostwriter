# Copy to .env and fill in. .env is gitignored.

# Google AI Studio key — https://aistudio.google.com/apikey
# Required by src/gen-art.ts (Gemini image generation). Nothing else needs it.
GEMINI_API_KEY=

# Optional: override the Gemini image model id if the default 404s.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Zernio API key — Zernio dashboard → API Keys → create key
# Required by src/publish.ts (Instagram carousel via Zernio).
# The IG account id + handle are non-secret and live in config/publish.json.
ZERNIO_API_KEY=
