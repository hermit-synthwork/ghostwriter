{
  "name": "ghostwriter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code pipeline that writes original funny/horror short stories and renders them as illustrated comic-panel carousels (4:5 + 9:16) for TikTok/IG, with a local review gate.",
  "scripts": {
    "art": "tsx src/gen-art.ts",
    "compose": "tsx src/compose.ts",
    "review": "tsx src/build-review.ts",
    "approve": "tsx src/approve.ts",
    "publish": "tsx src/publish.ts",
    "smoke": "tsx src/gemini.ts --smoke",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "run": "tsx src/run.ts",
    "story": "tsx src/write-story.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fontsource/bangers": "^5.1.0",
    "@fontsource/comic-neue": "^5.1.0",
    "@google/genai": "^1.0.0",
    "satori": "^0.12.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
