# Copy to .env.local and fill in. Production values go in the Vercel project env
# (project ghostwriter-review, team synthwork1) — redeploy after changing them.

# Neon (same database the engine uses)
DATABASE_URL=

# Clerk → Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user ids that can see every tenant in the review queue
REVIEW_ADMIN_USER_IDS=

# Zernio → Dashboard → API Keys (creates per-customer profiles + Instagram connect links)
ZERNIO_API_KEY=

# Stripe → Developers → API keys
STRIPE_SECRET_KEY=
# `stripe listen` prints this locally; in production, from the webhook endpoint
# for /api/stripe/webhook in the Stripe Dashboard. Differs per environment.
STRIPE_WEBHOOK_SECRET=
# The $138/month recurring price id (price_...)
STRIPE_PRICE_ID=
# The promotion code string (e.g. FOUNDING50) auto-applied at checkout while it
# has redemptions left. Leave blank to never auto-apply a promo.
STRIPE_FOUNDING_PROMO_CODE=
