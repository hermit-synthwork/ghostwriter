# Copy to .env and fill in. .env is gitignored.

# Google AI Studio key — https://aistudio.google.com/apikey
# Required by src/engine/art.ts (Gemini image generation). Nothing else needs it.
GEMINI_API_KEY=

# Optional: override the image model.
#   gemini-3.1-flash-image (default) | gemini-3.1-flash-lite-image | gemini-3-pro-image
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Zernio API key — Zernio dashboard → API Keys → create key
# Required by src/engine/publish.ts (Instagram carousel via Zernio).
# The IG/TikTok account ids + handles are non-secret and live in the Neon `tenant`
# rows (seeded by src/db/seed.ts).
ZERNIO_API_KEY=

# Anthropic API key — console.anthropic.com → API keys. Required by src/write-story.ts.
ANTHROPIC_API_KEY=

# Neon Postgres connection string — Neon dashboard → your project → Connection Details.
# Required by the engine (tenants, episodes, usage all live here).
DATABASE_URL=

# Neon *test* branch connection string — used only by `npm test` (DB integration tests).
DATABASE_URL_TEST=

# Vercel Blob read-write token — Vercel dashboard → Storage → your Blob store → Tokens.
# Required by src/lib/blob.ts (final panel JPEG uploads).
BLOB_READ_WRITE_TOKEN=
